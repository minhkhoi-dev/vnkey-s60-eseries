// vnkeyboot.mmp - the launcher the phone starts at boot (data/vnkey_startup.rss). It
// starts VnKey in the background, unless start at boot is off, and exits
// (src/VnKeyBoot.cpp).

TARGET          vnkeyboot.exe
TARGETTYPE      exe
UID             0 0xE7A10004            // development range, next to the app's and the plugin's
SECUREID        0xE7A10004
VENDORID        0
CAPABILITY      NONE

SOURCEPATH      ../src
SOURCE          VnKeyBoot.cpp

USERINCLUDE     ../inc
SYSTEMINCLUDE   /epoc32/include

LIBRARY         euser.lib efsrv.lib apparc.lib apgrfx.lib ws32.lib
