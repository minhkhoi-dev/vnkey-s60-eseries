// vnkey.rss - VnKey's resources: the settings list (the main screen), the menu, the
// softkeys, the queries and the notes.
//
// Built twice (CLAUDE.md "Design", the language): as vnkey.rsc with the Vietnamese texts of
// vnkey_vi.loc, the default, and from vnkey_en.rss, which defines VNKEY_LANG_EN and
// includes this file, as vnkey_en.rsc with those of vnkey_en.loc. The two have the same
// NAME and the same resources in the same order, so the same IDs (vnkey.rsg), and VnKey
// swaps one for the other while it runs. Every text is a qtn_ name from the .loc files.
NAME VNKY
CHARACTER_SET UTF8

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <appinfo.rh>
#include "VnKey.hrh"
// Generated by build.sh: VNKEY_SEND_LOG, 0 in a public build (no Send log).
#include "VnKeyBuild.hrh"

#ifdef VNKEY_LANG_EN
#include "vnkey_en.loc"
#else
#include "vnkey_vi.loc"
#endif

// The first three stay first: the framework reads EIK_APP_INFO as the third resource.
RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF r_default_document_name { buf = ""; }

RESOURCE EIK_APP_INFO
    {
    menubar = r_vnkey_menubar;
    cba = r_vnkey_softkeys_options_exit;
    }

// VnKey's own softkeys, in the language of the texts (Avkon's would be in the phone's).
// The command IDs are Avkon's, so they act as Avkon's softkeys do.
RESOURCE CBA r_vnkey_softkeys_options_exit
    {
    buttons =
        {
        CBA_BUTTON { id = EAknSoftkeyOptions; txt = qtn_vnkey_sk_options; },
        CBA_BUTTON { id = EAknSoftkeyExit;    txt = qtn_vnkey_sk_exit; }
        };
    }

RESOURCE CBA r_vnkey_softkeys_options_back
    {
    buttons =
        {
        CBA_BUTTON { id = EAknSoftkeyOptions; txt = qtn_vnkey_sk_options; },
        CBA_BUTTON { id = EAknSoftkeyBack;    txt = qtn_vnkey_sk_back; }
        };
    }

RESOURCE CBA r_vnkey_softkeys_ok_cancel
    {
    buttons =
        {
        CBA_BUTTON { id = EAknSoftkeyOk;     txt = qtn_vnkey_sk_ok; },
        CBA_BUTTON { id = EAknSoftkeyCancel; txt = qtn_vnkey_sk_cancel; }
        };
    }

RESOURCE CBA r_vnkey_softkeys_cancel
    {
    buttons =
        {
        CBA_BUTTON { id = EAknSoftkeyEmpty;  txt = ""; },
        CBA_BUTTON { id = EAknSoftkeyCancel; txt = qtn_vnkey_sk_cancel; }
        };
    }

RESOURCE CBA r_vnkey_softkeys_yes_no
    {
    buttons =
        {
        CBA_BUTTON { id = EAknSoftkeyYes; txt = qtn_vnkey_sk_yes; },
