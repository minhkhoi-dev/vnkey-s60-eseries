RESOURCE MENU_BAR r_vnkey_menubar
    {
    titles = { MENU_TITLE { menu_pane = r_vnkey_menu; } };
    }

// One menu for both screens: CVnKeyAppUi::DynInitMenuPaneL hides what the screen in front
// does not have (Change and Typing test on the settings list; Clear text and Settings in
// the typing test).
RESOURCE MENU_PANE r_vnkey_menu
    {
    items =
        {
        MENU_ITEM { command = EVnCmdChange;     txt = qtn_vnkey_menu_change; },
        MENU_ITEM { command = EVnCmdTyping;     txt = qtn_vnkey_menu_typing; },
        MENU_ITEM { command = EVnCmdClear;      txt = qtn_vnkey_menu_clear; },
        MENU_ITEM { command = EVnCmdSettings;   txt = qtn_vnkey_menu_settings; },
        MENU_ITEM { command = EVnCmdReload;     txt = qtn_vnkey_menu_reload; },
#if VNKEY_SEND_LOG
        MENU_ITEM { command = EVnCmdSendLog;    txt = qtn_vnkey_menu_send_log; },
#endif
        MENU_ITEM { command = EVnCmdClearLog;   txt = qtn_vnkey_menu_clear_log; },
        MENU_ITEM { cascade = r_vnkey_fep_menu; txt = qtn_vnkey_menu_fep; },
        MENU_ITEM { command = EAknSoftkeyExit;  txt = qtn_vnkey_menu_exit; }
        };
    }

RESOURCE MENU_PANE r_vnkey_fep_menu
    {
    items =
        {
        MENU_ITEM { command = EVnCmdFepList;   txt = qtn_vnkey_menu_fep_list; },
        MENU_ITEM { command = EVnCmdFepLoad;   txt = qtn_vnkey_menu_fep_load; },
        MENU_ITEM { command = EVnCmdFepCreate; txt = qtn_vnkey_menu_fep_create; }
        };
    }

// The settings list (CVnSettingList), the rows in the order of TVnSettingId.
RESOURCE AVKON_SETTING_ITEM_LIST r_vnkey_setting_list
    {
    title = "VnKey";
    items =
        {
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetVietnamese;
            name = qtn_vnkey_set_vietnamese;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_onoff_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetAllApps;
            name = qtn_vnkey_set_all_apps;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_onoff_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetBoot;
            name = qtn_vnkey_set_boot;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_onoff_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetLanguage;
            name = qtn_vnkey_set_language;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_language_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetTone;
            name = qtn_vnkey_set_tone;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_tone_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetWAlone;
            name = qtn_vnkey_set_w_alone;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_onoff_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetSpell;
            name = qtn_vnkey_set_spell;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_onoff_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetRestore;
            name = qtn_vnkey_set_restore;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_onoff_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetMacros;
            name = qtn_vnkey_set_macros;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_onoff_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetMethod;
            name = qtn_vnkey_set_method;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_method_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetPlace;
            name = qtn_vnkey_set_place;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_place_texts;
            },
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetLogKeys;
            name = qtn_vnkey_set_log_keys;
            setting_page_resource = r_vnkey_popup_page;
            associated_resource = r_vnkey_onoff_texts;
            }
        // The last row, so that no other row moves: a public build has none.
#if VNKEY_SEND_LOG
        ,
        AVKON_SETTING_ITEM
            {
            identifier = EVnSetServer;
            name = qtn_vnkey_set_server;
            setting_page_resource = r_vnkey_text_page;
            empty_item_text = qtn_vnkey_set_none;
            }
#endif
        };
    }

// The page of a row with a few values (the row's name is its title).
RESOURCE AVKON_SETTING_PAGE r_vnkey_popup_page
    {
    label = "";
    softkey_resource = r_vnkey_softkeys_ok_cancel;
    type = EAknCtPopupSettingList;
    editor_resource_id = r_vnkey_popup_list;
    }

RESOURCE POPUP_SETTING_LIST r_vnkey_popup_list
    {
    flags = 0;
    }

// The log server's page: an address:port, no predictive text.
RESOURCE AVKON_SETTING_PAGE r_vnkey_text_page
    {
    label = "";
    softkey_resource = r_vnkey_softkeys_ok_cancel;
    invalid_contents_softkey_resource = r_vnkey_softkeys_cancel;
    type = EEikCtEdwin;
    editor_resource_id = r_vnkey_server_edwin;
    }

RESOURCE EDWIN r_vnkey_server_edwin
    {
    flags = EEikEdwinNoLineOrParaBreaks;
    width = 16;
    lines = 1;
    maxlength = 60;
    default_case = EAknEditorLowerCase;
    avkon_flags = EAknEditorFlagNoT9 | EAknEditorFlagLatinInputModesOnly;
    }

// On / Off (CAknBinaryPopupSettingItem: the values 1 and 0).
RESOURCE AVKON_POPUP_SETTING_TEXTS r_vnkey_onoff_texts
    {
    setting_texts_resource = r_vnkey_onoff_values;
    popped_up_texts_resource = r_vnkey_onoff_popped;
    }

RESOURCE ARRAY r_vnkey_onoff_values
    {
    items =
        {
        AVKON_ENUMERATED_TEXT { value = 1; text = qtn_vnkey_on; },
        AVKON_ENUMERATED_TEXT { value = 0; text = qtn_vnkey_off; }
        };
    }

RESOURCE ARRAY r_vnkey_onoff_popped
    {
    items =
        {
        LBUF { txt = qtn_vnkey_on; },
        LBUF { txt = qtn_vnkey_off; }
        };
    }

