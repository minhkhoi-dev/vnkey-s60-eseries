RESOURCE TBUF r_vnkey_note_skipped      { buf = qtn_vnkey_note_skipped; }
RESOURCE TBUF r_vnkey_note_sending      { buf = qtn_vnkey_note_sending; }
RESOURCE TBUF r_vnkey_note_busy         { buf = qtn_vnkey_note_busy; }
RESOURCE TBUF r_vnkey_note_sent         { buf = qtn_vnkey_note_sent; }
