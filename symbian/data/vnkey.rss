// Telex in all apps, to off: off now (may restart the phone) or at the next restart.
RESOURCE DIALOG r_vnkey_off_query
    {
    flags = EGeneralQueryFlags;
    buttons = r_vnkey_softkeys_yes_no;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_CONFIRMATION_QUERY
                {
                layout = EConfirmationQueryLayout;
                label = qtn_vnkey_off_query;
                };
            }
        };
    }

// Options > Send log: the address of the web stub on the Mac, filled in with the last one.
RESOURCE DIALOG r_vnkey_server_query
    {
    flags = EGeneralQueryFlags;
    buttons = r_vnkey_softkeys_ok_cancel;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_DATA_QUERY
                {
                layout = EDataLayout;
                label = qtn_vnkey_server_query;
                control = EDWIN
                    {
                    flags = EEikEdwinNoHorizScrolling | EEikEdwinResizable;
                    maxlength = 60;
                    width = 16;
                    lines = 1;
                    };
                };
            }
        };
    }

