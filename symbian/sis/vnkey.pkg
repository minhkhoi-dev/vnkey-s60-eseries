; vnkey.pkg - installation package for VnKey
; $(EPOCROOT) and @VERSION_*@ are substituted by group/build.sh from ../VERSION
&EN

#{"VnKey"},(0xE7A10001),@VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_BUILD@

%{"VnKey Dev"}
:"VnKey Dev"

; S60 3rd Edition FP2 (E72)
[0x102752AE], 0, 0, 0, {"S60ProductID"}

; Everything on the phone's memory (C:), none of it on the memory card: with the card
; out, the system's FEP (the plugin, when it is switched on) and VnKey, which switches it
; back, must still be there.
"$(EPOCROOT)epoc32/release/gcce/urel/vnkey.exe"-"c:\sys\bin\vnkey.exe"
"$(EPOCROOT)epoc32/data/z/resource/apps/vnkey.rsc"-"c:\resource\apps\vnkey.rsc"
"$(EPOCROOT)epoc32/data/z/resource/apps/vnkey_en.rsc"-"c:\resource\apps\vnkey_en.rsc"
"$(EPOCROOT)epoc32/data/z/resource/apps/vnkey_aif.mif"-"c:\resource\apps\vnkey_aif.mif"
"$(EPOCROOT)epoc32/data/z/private/10003a3f/apps/vnkey_reg.rsc"-"c:\private\10003a3f\import\apps\vnkey_reg.rsc"

; The FEP plugin (roadmap 2)
"$(EPOCROOT)epoc32/release/gcce/urel/vnkeyfep.dll"-"c:\sys\bin\vnkeyfep.dll"
"$(EPOCROOT)epoc32/data/z/resource/plugins/vnkeyfep.rsc"-"c:\resource\plugins\vnkeyfep.rsc"

; Start at boot (roadmap 4): the phone runs the launcher at boot, which starts VnKey in the
; background unless settings.txt says boot=0. The brackets are part of the file name:
; [package UID].rsc in the Startup List Management server's import folder.
"$(EPOCROOT)epoc32/release/gcce/urel/vnkeyboot.exe"-"c:\sys\bin\vnkeyboot.exe"
"$(EPOCROOT)epoc32/data/z/private/101f875a/import/vnkey_startup.rsc"-"c:\private\101f875a\import\[E7A10001].rsc"
